# Example environment file for Selene Moderation Framework
# Copy this file to .env and set your real values before running.

# Required: your Discord bot token (keep this secret)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Optional: startup announcement settings
# Set channel and guild IDs to have Selene post a startup message when ready
STARTUP_ANNOUNCE_CHANNEL_ID=
STARTUP_ANNOUNCE_GUILD_ID=
# Use 'plain' or 'embed'
STARTUP_ANNOUNCE_FORMAT=plain
# Use \n for newlines inside this value
STARTUP_ANNOUNCE_TEXT=Selene Moderation Framework initialized successfully. All subcomponents nominal.

# Optional: environment mode
NODE_ENV=development
